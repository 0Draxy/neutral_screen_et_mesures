  "preserve_dynamic": [
    "current active stage folder",
    "immediately previous successful stage folder",
    "current discovery pool data and manifest",
    "locked validation selection and any validation data not yet consumed",
    "current frozen protocol/candidate/source manifests",
    "current state/results required by next stage"
